    "colors": {
        "J-H": {"band1": "J", "band2": "H"},
        "J-K": {"band1": "J", "band2": "K"},
        "J-W1": {"band1": "J", "band2": "W1"},
        "J-W2": {"band1": "J", "band2": "W2"},
        "H-K": {"band1": "H", "band2": "K"},
        "H-W1": {"band1": "H", "band2": "W1"},
        "H-W2": {"band1": "H", "band2": "W2"},
        "K-W1": {"band1": "K", "band2": "W1"},
        "K-W2": {"band1": "K", "band2": "W2"},
        "W1-W2": {"band1": "W1", "band2": "W2"}
    },
    "photometry": {
        "J": {"mag": "J_2MASS", "err": "Jerr_2MASS"},
        "H": {"mag": "H_2MASS", "err": "Herr_2MASS"},
        "K": {"mag": "Ks_2MASS", "err": "Kserr_2MASS"},
        "W1": {"mag": "W1", "err": "W1err"},
        "W2": {"mag": "W2", "err": "W2err"}
