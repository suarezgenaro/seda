{
    "_comment": "Empirical reference sequences for color_anomaly",
    "faherty16": {
        "ref": "Faherty et al. (2016)",
        "bibcode": "2016ApJS..225...10F",
        "tables": "Tables 15-16 (field/normal mean infrared colors, M7-L8)",
        "file": "faherty16_tables15_16.dat",
        "spt_min": 7,
        "spt_max": 18
    },
    "faherty16_table1": {
        "ref": "Faherty et al. (2016) Table 1",
        "bibcode": "2016ApJS..225...10F",
        "note": "Low surface gravity M7-L8 sample used to build a 'young' sequence, recomputed from bundled photometry (not a published mean table).",
        "file": "faherty16_table1_sample.dat",
        "spt_column": "spt_flt_assumed",
        "ograv_column": "OGrav",
        "igrav_column": "IGrav",
        "low_gravity_tokens": ["beta", "gamma", "delta"],
        "max_mag_err": 0.1,
        "min_bin_count": 3
    },
    "ultracool": {
        "ref": "Ultracool Sheet (Main v2, less columns)",
        "file": "ultracool_sheet.dat",
        "spt_column": "spt_adop_flt",
        "youth_column": "youth_evidence",
        "max_mag_err": 0.1,
        "min_bin_count": 3
    },
    "colors": {
        "J-H": {"band1": "J", "band2": "H"},
        "J-K": {"band1": "J", "band2": "K"},
        "J-W1": {"band1": "J", "band2": "W1"},
        "J-W2": {"band1": "J", "band2": "W2"},
        "H-K": {"band1": "H", "band2": "K"},
        "H-W1": {"band1": "H", "band2": "W1"},
        "H-W2": {"band1": "H", "band2": "W2"},
        "K-W1": {"band1": "K", "band2": "W1"},
        "K-W2": {"band1": "K", "band2": "W2"},
        "W1-W2": {"band1": "W1", "band2": "W2"}
    },
    "photometry": {
        "J": {"mag": "J_2MASS", "err": "Jerr_2MASS"},
        "H": {"mag": "H_2MASS", "err": "Herr_2MASS"},
        "K": {"mag": "Ks_2MASS", "err": "Kserr_2MASS"},
        "W1": {"mag": "W1", "err": "W1err"},
        "W2": {"mag": "W2", "err": "W2err"}
    },
    "faherty16_table1_photometry": {
        "J": {"mag": "Jmag", "err": "e_Jmag"},
        "H": {"mag": "Hmag", "err": "e_Hmag"},
        "K": {"mag": "Ksmag", "err": "e_Ksmag"},
        "W1": {"mag": "W1mag", "err": "e_W1mag"},
        "W2": {"mag": "W2mag", "err": "e_W2mag"}
    },
    "young_tokens": ["YMG", "lowg", "SFR", "HYA"],
    "old_values": ["N", "Field"]
}
